# Copy to .env and fill in. .env is git-ignored; never commit it.
OPENROUTER_API_KEY=
# Hard cap in USD for a single tribunal run. The run aborts when reached.
RUN_BUDGET_USD=5.00
PORT=3000
# Optional. A cheap paid model id so Mode A works (this account 403s on the
# free tier — decisions.md D-012). Leave unset to use the live cheapest pick.
# DEMO_MODEL_ID=openai/gpt-oss-20b
# Optional. Where the SQLite database file lives. Unset -> ./db/tribunal.db.
# In a deploy this points at a persistent disk mount (Render: /var/data).
# DB_PATH=/var/data/tribunal.db