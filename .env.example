# Copy to .env and fill in. .env is git-ignored; never commit it.
OPENROUTER_API_KEY=
# Hard cap in USD for a single tribunal run. The run aborts when reached.
RUN_BUDGET_USD=5.00
PORT=3000
# Optional. A cheap paid model id so Mode A works (this account 403s on the
# free tier — decisions.md D-012). Leave unset to use the live cheapest pick.
# DEMO_MODEL_ID=openai/gpt-oss-20b
# The run store. Unset -> a local libSQL file at ./db/tribunal.db (D-017).
# For a deploy, point at a Turso database instead (set both):
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
# Optional. Override the local libSQL file path (local dev only).
# DB_PATH=./db/tribunal.db